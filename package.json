{
  "name": "task-board",
  "version": "1.0.0",
  "description": "A keyboard-friendly kanban board in React and TypeScript, with everything stored locally.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
